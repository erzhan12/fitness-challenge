# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Webhook Secret Token
# Generate a random secret token for webhook verification
# Example: openssl rand -hex 32
TELEGRAM_SECRET_TOKEN=your_secret_token_here

# Telegram Webhook URL (optional - set automatically by scripts/start_webhook_dev.sh)
# Format: https://your-ngrok-url.ngrok-free.app/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Admin API Key
# Generate a random key for securing admin/cron endpoints
# Example: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here

# App Configuration
TZ=Asia/Almaty
TARGET_CHAT_ID=

# Habit Reward Integration (optional)
# Per-user API key and habit ID are stored in user_settings DB table.
# Only the shared base URL is configured here.
HABIT_REWARD_BASE_URL=https://habitreward.org
